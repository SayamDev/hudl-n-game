# Server-only: copy to .env.local and fill in locally. Never use a VITE_ prefix.
GROQ_API_KEY=
# Set true only after confirming the provider account remains on the Free plan.
GROQ_FREE_TIER_CONFIRMED=false
GROQ_MODEL=openai/gpt-oss-20b
# Required for HTTPS deployment; exact scheme + host, no trailing slash.
# APP_ORIGIN=https://your-app.example
