  "narrative": {
    "northStar": "The After Hours illustrated deck",
    "overview": "After Hours is a playable illustrated noir deck: midnight card faces, ivory lettering, electric lime actions and violet framing. Condensed display lettering supplies the poster character; the existing Space Grotesk body and controls remain intentionally readable. Names, instructions and controls are real accessible DOM; illustration regions supply atmosphere.\n\nThis is a code-led implementation of the direction in `docs/surface-after-hours.md`. Candidate C from 12ui is a critique reference, not an approved pixel comp. Its hosted run ID is not a concept seed. No formal concept-roll seed, quality card or approved-comp pixel gate exists. The previous system is archived at `docs/design-archive/social-club-before-after-hours/DESIGN.md`; Classic has its separate archive. Settings → After Hours art & motion switches back to the previous Social Club look without resetting game data; the original Social Club and Classic design options also remain.",
    "keyCharacteristics": [
      "Illustration regions within functional game cards; no screenshot UI.",
      "Bebas Neue display with Space Grotesk body and controls.",
      "Twenty stable framed alibis paired with player names.",
      "Connected deck motion for public state changes; immediate private concealment.",
      "Phone-first layouts with keyboard and reduced-motion alternatives."
    ],
    "rules": [
      {
        "name": "The Paired Identity Rule",
        "body": "Player names accompany alibi art; colour and illustration never carry identity alone.",
        "section": "colors"
      },
      {
        "name": "The Public Motion Rule",
        "body": "Motion can stage public state changes, but it must never delay the removal of a private role or word.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do pair every alibi with the player name in functional contexts.",
      "Do keep private role and word content conditionally mounted only during a hold.",
      "Do reuse local artwork, preserve its attribution, and keep text and controls in the DOM.",
      "Do provide a direct button for public reveals and respect reduced motion.",
      "Do retain reversible design preferences and existing player identifiers."
    ],
    "donts": [
      "Don't animate private concealment or move the hold target on press.",
      "Don't turn a generated critique reference into an approved-comp or pixel-match claim.",
      "Don't use a whole generated UI image as a screen.",
      "Don't infer complete accessibility or device validation from scoped browser captures."
    ]
  }
}
